extends SceneTree

# エフェクト方向性検証アニメ(表示層ツール。float可)。連番PNGを吐き、ffmpegでMP4化する。
# ROUNDS解析で判明した要点を実装して「動き」で見せる:
#  (1)火花は丸でなく流れる筋(進行方向へ伸ばす)。大小・長短・タイミングがバラバラ
#  (2)中心均等拡散でなく、着弾点から進行/跳ね返り方向のコーンへ吹き飛ぶ
#  (3)地面やブロックを貫通せず、面で弾かれて外へ散る
#  (4)白い頭+色の尾。色は複数混在
#  (5)地面着弾の土煙は入射慣性で向きが変わる(真上落下=左右/斜め突入=横)
# 使い方: tools\godot\...console.exe --path . -s res://scripts/gen_fx_anim.gd -- OUTDIR
# 出力: OUTDIR/f_%03d.png (呼び出し側でffmpeg -> mp4)

const GLOW := preload("res://assets/fx/glow.png")
const SMOKE := preload("res://assets/fx/smoke.png")
const BLOB := preload("res://assets/fx/blob.png")

const W := 900
const H := 380
const GROUND_Y := 300.0
const FRAMES := 150   # 5秒 @30fps

var _canvas
var _dust
var _vp

func _init() -> void:
	var outdir := "res://fx_anim"
	var args := OS.get_cmdline_user_args()
	if args.size() > 0:
		outdir = args[0]
	DirAccess.make_dir_recursive_absolute(outdir)

	_vp = SubViewport.new()
	_vp.size = Vector2i(W, H)
	_vp.transparent_bg = false
	_vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS

	var scene := SceneDraw.new()
	_vp.add_child(scene)
	# 土煙(通常合成)
	_dust = DustDraw.new()
	_vp.add_child(_dust)
	# 火花・発光(加算合成)
	_canvas = FxDraw.new()
	var mat := CanvasItemMaterial.new()
	mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	_canvas.material = mat
	_vp.add_child(_canvas)
	var lbl := LabelDraw.new()
	_vp.add_child(lbl)
	root.add_child(_vp)

	for f in FRAMES:
		_canvas.frame = f
		_dust.frame = f
		lbl.frame = f
		_canvas.queue_redraw()
		_dust.queue_redraw()
		lbl.queue_redraw()
		await process_frame
		await process_frame
		var img: Image = _vp.get_texture().get_image()
		img.save_png("%s/f_%03d.png" % [outdir, f])
	print("fx anim frames saved to: ", outdir, " (", FRAMES, " frames)")
	quit()

# 決定的ハッシュ(0..1)。seed,i,チャンネルから
static func hv(seed: int, i: int, ch: int) -> float:
	var h := (seed * 2654435761 + i * 40503 + ch * 19349663) & 0x7FFFFFFF
	return float(h % 100003) / 100003.0

# 背景・地面・ブロック
class SceneDraw:
	extends Node2D
	func _draw() -> void:
		draw_rect(Rect2(0, 0, W, H), Color(0.055, 0.065, 0.13))
		draw_rect(Rect2(0, GROUND_Y, W, H - GROUND_Y), Color(0.10, 0.09, 0.14))  # 地面
		draw_rect(Rect2(430, 150, 70, 60), Color(0.16, 0.13, 0.18))  # ブロック(S4用)

# シナリオ定義: 各バーストの発火フレーム・種類・原点・向き。
# 同じ種類でもseedを変えて複数回出し「毎回形が変わる」ことを見せる
# kind: attack/slam/drop/blast。sd=形の乱数シード(これを変えるだけで別の形になる)
const SHOTS := [
	{"f0": 6,   "kind": "attack", "pos": Vector2(220, 140), "ang": 3.14159, "spread": 1.5, "sd": 11}, # 右打ち→左
	{"f0": 34,  "kind": "attack", "pos": Vector2(230, 160), "ang": 3.14159, "spread": 1.5, "sd": 97}, # 同じ攻撃でも別の形
	{"f0": 62,  "kind": "slam",   "pos": Vector2(250, GROUND_Y), "ang": -0.35, "spread": 1.2, "sd": 23}, # 斜め突入
	{"f0": 92,  "kind": "drop",   "pos": Vector2(640, GROUND_Y), "ang": -1.5708, "spread": 0.6, "sd": 41}, # 真上落下
	{"f0": 120, "kind": "blast",  "pos": Vector2(430, 180), "ang": 3.14159, "spread": 1.8, "sd": 59}, # ブロック面
]

# 火花・発光レイヤー
class FxDraw:
	extends Node2D
	var frame := 0
	static func hv(seed: int, i: int, ch: int) -> float:
		var h := (seed * 2654435761 + i * 40503 + ch * 19349663) & 0x7FFFFFFF
		return float(h % 100003) / 100003.0
	func _draw() -> void:
		for s in SHOTS:
			var life := 26.0 if s["kind"] == "blast" else 22.0
			var t := float(frame - s["f0"]) / life
			if t < 0.0 or t >= 1.0:
				continue
			_burst(s, t)

	# 爆発1発。seed(sd)で「形」を毎回変える: クラスタ本数・光球の数と配置・
	# 火花の散り方が全部seed依存なので、同じ種類でも二度と同じ形にならない
	func _burst(s: Dictionary, t: float) -> void:
		var pos: Vector2 = s["pos"]
		var kind: String = s["kind"]
		var base_ang: float = s["ang"]
		var spread: float = s["spread"]
		var seed := int(s["sd"]) * 2749 + 13
		var flash := pow(1.0 - t, 3.0)
		var pal := _palette(kind)
		# (1)白熱コアの閃光(出だしだけ)
		_orb(GLOW, pos, 18.0 + 22.0 * flash, Color(1, 1, 1, 0.9 * flash))
		_orb(GLOW, pos, 44.0 * flash + 10.0, Color(pal[1].r, pal[1].g, pal[1].b, 0.5 * flash))
		# (2)丸い光球(ボケ)を数個、コーン内のランダム位置に散らす。数・大きさ・色・位置がseed依存
		var n_orb := 3 + int(hv(seed, 0, 7) * 4.0)  # 3..6個
		for j in n_orb:
			var oj_t := t / (0.5 + 0.4 * hv(seed, j, 8))  # 球ごとに寿命ずらし
			if oj_t >= 1.0:
				continue
			var of := pow(1.0 - oj_t, 1.5)
			var oang := base_ang + (hv(seed, j, 9) - 0.5) * spread
			var odist := (10.0 + 55.0 * hv(seed, j, 10)) * (1.0 - pow(1.0 - oj_t, 2.0))
			var op := pos + Vector2.from_angle(oang) * odist
			op.y += 30.0 * oj_t * oj_t * hv(seed, j, 11)
			if op.y > GROUND_Y:
				op.y = GROUND_Y - (op.y - GROUND_Y) * 0.3
			var odiam := 10.0 + 34.0 * hv(seed, j, 12)  # 大小さまざま
			var oc: Color = pal[(j + 1) % pal.size()]
			_orb(GLOW, op, odiam * (0.5 + 0.5 * of), Color(oc.r, oc.g, oc.b, 0.75 * of))
			_orb(GLOW, op, odiam * 0.4 * of, Color(1, 1, 1, 0.7 * of))  # 球の芯は白熱
		# (3)火花の筋を「クラスタ(束)」で放つ=均等でなく偏った有機的な散り方。
		# 束の本数・向き・太さがseed依存で毎回違う
		var n_cl := 2 + int(hv(seed, 0, 13) * 3.0)  # 2..4束
		for cl in n_cl:
			var cl_ang := base_ang + (hv(seed, cl, 14) - 0.5) * spread
			var cl_tight := 0.15 + 0.5 * hv(seed, cl, 15)  # 束の締まり
			var per := 3 + int(hv(seed, cl, 16) * 5.0)     # 束あたりの本数
			for i in per:
				_streak_spark(pos, cl_ang, cl_tight, t, seed, cl * 40 + i, pal)

	func _palette(kind: String) -> Array:
		match kind:
			"blast":
				return [Color(1,1,1), Color(1.0,0.5,0.9), Color(0.6,0.4,1.0), Color(1.0,0.7,0.3)]
			_:
				return [Color(1,1,1), Color(1.0,0.85,0.4), Color(1.0,0.55,0.2), Color(1.0,0.35,0.15)]

	func _streak_spark(origin: Vector2, ang0: float, tight: float, t: float,
			seed: int, i: int, pal: Array) -> void:
		var plife: float = 0.5 + 0.5 * hv(seed, i, 0)
		var lt := t / plife
		if lt >= 1.0:
			return
		var ease := 1.0 - pow(1.0 - lt, 2.1)
		var fade := pow(1.0 - lt, 1.5)
		var ang := ang0 + (hv(seed, i, 1) - 0.5) * tight
		var spd_n: float = hv(seed, i, 2)
		var reach := 55.0 + 175.0 * spd_n
		var dir := Vector2.from_angle(ang)
		var pos := origin + dir * reach * ease
		var grav := (24.0 + 60.0 * hv(seed, i, 3)) * lt * lt
		pos.y += grav
		if pos.y > GROUND_Y:
			pos.y = GROUND_Y - (pos.y - GROUND_Y) * 0.35
		var vel := (dir + Vector2(0.0, grav / maxf(reach * ease, 1.0))).normalized()
		var big: float = hv(seed, i, 4)
		var length := (16.0 + 48.0 * spd_n) * fade * (0.6 + 1.1 * big)
		var thick := (2.0 + 3.5 * big) * (0.5 + 0.5 * fade)
		var col: Color = pal[i % pal.size()]
		var body := col.lerp(Color(1, 1, 1), 0.15 * fade)
		_streak(pos, vel, length, thick, Color(body.r, body.g, body.b, fade))
		var hr := thick * 1.5
		_orb(GLOW, pos, hr * 2.2, Color(1, 1, 1, 0.9 * fade))  # 白熱の頭

	func _streak(p: Vector2, vel: Vector2, length: float, thick: float, col: Color) -> void:
		# glowを速度方向へ長く、直交方向へ細く伸ばして筋にする
		var ang := vel.angle()
		var sx := length / float(GLOW.get_width())
		var sy := thick / float(GLOW.get_height())
		draw_set_transform(p, ang, Vector2(sx, sy))
		draw_texture(GLOW, -GLOW.get_size() * 0.5, col)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

	func _orb(tex: Texture2D, p: Vector2, diam: float, col: Color) -> void:
		var sc := diam / float(tex.get_width())
		draw_set_transform(p, 0.0, Vector2(sc, sc))
		draw_texture(tex, -tex.get_size() * 0.5, col)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

# 土煙レイヤー(通常合成)。入射慣性で向きが変わる
class DustDraw:
	extends Node2D
	var frame := 0
	static func hv(seed: int, i: int, ch: int) -> float:
		var h := (seed * 2654435761 + i * 40503 + ch * 19349663) & 0x7FFFFFFF
		return float(h % 100003) / 100003.0
	func _draw() -> void:
		# 丸ブロブは地面だけでなく全ての着弾(空中の攻撃/ブロック)にも出す=ROUNDSの
		# 「丸エフェクトが全体に適用」を再現。空中は小さめの土煙(パフ)
		for s in SHOTS:
			var t := float(frame - s["f0"]) / 24.0
			if t < 0.0 or t >= 1.0:
				continue
			_dust(s, t)

	func _dust(s: Dictionary, t: float) -> void:
		# ROUNDS式の土煙: 半透明で薄れて消えるのでなく「不透明のベタ塗りのまま縮小して」消える。
		# 輪郭のある丸塊(メタボール)+飛ぶ楕円ペレット。色は温かいクリーム/タン。
		# 不透明なので重なっても濃淡が出ない(=透けたエフェクトに見えない)
		var kind: String = s["kind"]
		var pos: Vector2 = s["pos"]
		var seed := int(s["sd"]) * 271 + 3
		var ground := kind == "slam" or kind == "drop"
		var scale_mul := 0.55 if not ground else 1.0  # 空中は小さめ
		var tan := Color(0.86, 0.78, 0.68)
		var cream := Color(0.92, 0.88, 0.80)
		# 消え方: 立ち上がりで一気に膨らみ→不透明のまま縮小して消える(色は薄めない)
		var rise := smoothstep(0.0, 0.14, t)
		var shrink := 1.0 - smoothstep(0.42, 1.0, t)
		var mass_scale := rise * shrink
		# 慣性方向
		var flow: Vector2
		match kind:
			"drop": flow = Vector2(1, 0)
			"slam": flow = Vector2(0.9, -0.35).normalized()
			"attack": flow = Vector2.from_angle(float(s["ang"]))  # 打った逆方向
			_: flow = Vector2.from_angle(float(s["ang"]))
		# (1)本体の塊: 丸ブロブを少しずらして重ねる。全て不透明(alpha=1)、縮小で消す
		if mass_scale > 0.01:
			var n_blob := 3 + int(hv(seed, 0, 5) * 3.0)
			for j in n_blob:
				var off := Vector2((hv(seed, j, 6) - 0.5) * 26.0, -(hv(seed, j, 7)) * 14.0)
				if not ground:
					off += flow * (8.0 + 16.0 * hv(seed, j, 8))
				var p := pos + off
				if p.y > GROUND_Y:
					p.y = GROUND_Y
				var diam := (20.0 + 26.0 * hv(seed, j, 9)) * scale_mul * mass_scale
				_blob(p, diam, diam, 0.0, Color(tan.r, tan.g, tan.b, 1.0))  # 不透明
		# (2)飛び散る楕円ペレット: 不透明のまま、縮小して消える
		var n_pel := 10 + int(hv(seed, 1, 10) * 8.0)
		for i in n_pel:
			var plt := t / (0.5 + 0.45 * hv(seed, i, 11))
			if plt >= 1.0:
				continue
			var pe := 1.0 - pow(1.0 - plt, 2.0)
			var p_shrink := 1.0 - smoothstep(0.35, 1.0, plt)  # 不透明のまま縮小
			var basev := flow
			if kind == "drop":
				basev = Vector2(1.0 if (i % 2 == 0) else -1.0, -0.25).normalized()
			var ang := basev.angle() + (hv(seed, i, 12) - 0.5) * 1.0
			var spd := (40.0 + 90.0 * hv(seed, i, 13)) * scale_mul
			var d := Vector2.from_angle(ang)
			var pp := pos + d * spd * pe
			pp.y += 30.0 * plt * plt  # 重力
			if pp.y > GROUND_Y:
				pp.y = GROUND_Y - (pp.y - GROUND_Y) * 0.2
			var sz := (3.5 + 6.0 * hv(seed, i, 14)) * scale_mul * p_shrink
			if sz < 0.4:
				continue
			var elong := 1.0 + 2.0 * hv(seed, i, 15)  # 楕円の伸び(速度方向)
			_blob(pp, sz * elong, sz, d.angle(), Color(cream.r, cream.g, cream.b, 1.0))  # 不透明

	func _blob(p: Vector2, w: float, h: float, ang: float, col: Color) -> void:
		# 輪郭のある丸塊/楕円をblob.pngで描く。w,h=直径、angで楕円を回す
		draw_set_transform(p, ang, Vector2(w / float(BLOB.get_width()), h / float(BLOB.get_height())))
		draw_texture(BLOB, -BLOB.get_size() * 0.5, col)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

	func _soft(p: Vector2, diam: float, col: Color) -> void:
		var sc := diam / float(SMOKE.get_width())
		draw_set_transform(p, 0.0, Vector2(sc, sc))
		draw_texture(SMOKE, -SMOKE.get_size() * 0.5, col)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

class LabelDraw:
	extends Node2D
	var frame := 0
	func _draw() -> void:
		var f := ThemeDB.fallback_font
		var txt := ""
		for s in SHOTS:
			if frame >= int(s["f0"]) and frame < int(s["f0"]) + 30:
				match s["kind"]:
					"attack": txt = "ATTACK: 右へ打つ -> 左へ吹き飛ぶ(逆方向)"
					"slam": txt = "SLAM: 斜め突入 -> 横へ火花+土煙(慣性)"
					"drop": txt = "DROP: 真上落下 -> 土煙は左右対称"
					"blast": txt = "BLAST: ブロック面で弾かれ外へ散る(貫通しない)"
		draw_string(f, Vector2(12, 26), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, Color(1, 1, 0.7))
